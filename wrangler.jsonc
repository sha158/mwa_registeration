{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: serves the Vite build. No Worker script — Supabase is the only backend.
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "mwa-registeration",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    // Unknown paths (React Router routes like /admin/teams/:id) serve index.html.
    "not_found_handling": "single-page-application"
  }
}
