# Supabase (publishable key only — never put a secret / service-role key in a VITE_ variable)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Development only: run against in-memory mocks instead of Supabase
# VITE_USE_MOCKS=true
# VITE_MOCK_SCENARIO=none   # none | full | network | duplicate | upload-fail
